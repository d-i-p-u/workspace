{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "workspace",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "routes": [
    { "pattern": "oddkult.com", "custom_domain": true },
    { "pattern": "www.oddkult.com", "custom_domain": true }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "oddkult-orders",
      "database_id": "fe7a8162-3c0d-4428-a64c-2313251f341b"
    }
  ],
  "observability": { "enabled": true }
  // Secrets (never commit): npx wrangler secret put ADMIN_KEY
  // Optional:               npx wrangler secret put ORDER_WEBHOOK_URL
}
